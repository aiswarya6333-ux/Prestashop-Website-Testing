<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Prestashop Cross Browser Suite" preserve-order="true">

  <test name="Chrome Tests">
  <parameter name="browser" value="chrome"/>
    <classes>
      <class name="tests.RegistrationTest"/>
      <class name="tests.SignInTest"/>
      <class name="tests.HomePgTest"/>
      <class name="tests.ProductSearchTest"/>
      <class name="tests.ProductDetailsTest"/>
      <class name="tests.ShoppingCartTest"/>
      <class name="tests.CheckoutPgTest"/>
    </classes>
  </test> <!-- Test -->
  
  <test name="Edge Tests">
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="tests.RegistrationTest"/>
            <class name="tests.SignInTest"/>
            <class name="tests.HomePgTest"/>
            <class name="tests.ProductSearchTest"/>
            <class name="tests.ProductDetailsTest"/>
            <class name="tests.ShoppingCartTest"/>
            <class name="tests.CheckoutPgTest"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="tests.RegistrationTest"/>
            <class name="tests.SignInTest"/>
            <class name="tests.HomePgTest"/>
            <class name="tests.ProductSearchTest"/>
            <class name="tests.ProductDetailsTest"/>
            <class name="tests.ShoppingCartTest"/>
            <class name="tests.CheckoutPgTest"/>
        </classes>
    </test>
    
</suite> <!-- Suite -->
